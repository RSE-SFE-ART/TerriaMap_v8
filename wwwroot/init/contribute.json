r=\"proj_name\">Project Name</label></td><td><input type=\"text\" id=\"proj_name\" name=\"name\" size=\"32\" style=\"color:black;\"></td></tr><tr><td><label for=\"ptype\">Type *</label></td><td><select id=\"ptype\" name=\"type\" required style=\"color:black;\"><option value=\"\" disabled selected>Select…</option><option value=\"floating\">Floating</option><option value=\"bottom-fixed\">Bottom fixed</option></select></td></tr><tr><td><label for=\"company\">Proposing company</label></td><td><input type=\"text\" id=\"company\" name=\"company\" size=\"32\" style=\"color:black;\"></td></tr><tr><td><label for=\"power_mw\">Power [MW] *</label></td><td><input type=\"number\" id=\"power_mw\" name=\"power_mw\" required min=\"0\" step=\"any\" style=\"color:black;\"></td></tr><tr><td><label for=\"n_WTG\">Number of WTG</label></td><td><input type=\"number\" id=\"n_WTG\" name=\"n_WTG\" min=\"0\" step=\"1\" style=\"color:black;\"></td></tr><tr><td><label for=\"status\">Status *</label></td><td><select id=\"status\" name=\"status\" required style=\"color:black;\"><option value=\"\" disabled selected>Select…</option><option value=\"preliminary_study\">Preliminary study</option><option value=\"permitting_eia_ongoing\">Permitting (EIA ongoing)</option><option value=\"permitting_eia_completed\">Permitting (EIA completed)</option><option value=\"authorized\">Authorized</option><option value=\"under_construction\">Under construction</option><option value=\"operational\">Operational</option></select></td></tr><tr><td><label for=\"source_url\">Source (link)</label></td><td><input type=\"url\" id=\"source_url\" name=\"source\" size=\"32\" style=\"color:black;\"></td></tr></table><table width=\"1000\" style=\"border-left: 1px solid #626973;border-right: 1px solid #626973; margin-top:8px;\"><tr style=\"border-left: 1px solid #626973;border-right: 1px solid #626973;\"><td><p style='text-align:justify; font-size:12px'>RSE - Ricerca sul Sistema Energetico SpA informs that the optional, explicit 